    "main": "./dist/index.mjs",
    "name": "bili-welcome",
    "repository": "github:Pcrab/bili-welcome",
    "scripts": {
        "build": "unbuild",
        "check": "tsc --noEmit",
        "format": "biome check --write ./src",
